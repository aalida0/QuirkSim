+void QuirkStringStore::beginHandoff(int pdg, int parentID, int daughterPDG) {
+  const int i=pdg>0 ? 0 : 1;
+  if ((pdg>0)!=(daughterPDG>0))
+    G4Exception("beginHandoff","WrongEndpointSign",FatalException,"daughter changed endpoint slot");
+  m_handoffs[i].begin(parentID,daughterPDG,m_strings[i].HistoryFingerprint(),m_strings[1-i].HistoryFingerprint());
+}
+void QuirkStringStore::consumeHandoff(const G4Track& daughter) {
+  const int pdg=daughter.GetDefinition()->GetPDGEncoding(), i=pdg>0 ? 0 : 1;
+  auto& token=m_handoffs[i];
+  const auto a=m_strings[i].HistoryFingerprint(), b=m_strings[1-i].HistoryFingerprint();
+  try { token.consume(daughter.GetParentID(),pdg,a,b); }
+  catch (const std::exception& e) {
+    G4Exception("consumeHandoff","WeakHandoffMismatch",FatalException,e.what());
+  }
+  m_strings[i].SetVelocity(daughter.GetDynamicParticle()->Get4Momentum()/daughter.GetDynamicParticle()->GetMass());
+  m_strings[i].SetKineticEnergy(daughter.GetKineticEnergy());
+  std::ostringstream s;
+  s << "QP_WEAK_JSON {\"kind\":\"handoff\",\"parent_track\":" << daughter.GetParentID()
+    << ",\"daughter_track\":" << daughter.GetTrackID() << ",\"daughter_pdg\":" << pdg
+    << ",\"own_fingerprint\":\"" << a << "\",\"partner_fingerprint\":\"" << b
+    << "\",\"history_preserved\":true}";
+  G4cout << s.str() << G4endl;
+}
+void QuirkStringStore::verifyNoPendingHandoffs() const {
+  if (m_handoffs[0].pending || m_handoffs[1].pending)
+    G4Exception("verifyNoPendingHandoffs","UnconsumedWeakDaughter",FatalException,"neutral daughter never took ownership");
+}
